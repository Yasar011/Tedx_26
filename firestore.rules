rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? me().role : 'anonymous';
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isCore() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'core');
    }

    function isDeptHead() {
      return isSignedIn() && myRole() == 'department_head';
    }

    function myDepartmentId() {
      return isSignedIn() ? me().departmentId : null;
    }

    function myDepartmentName() {
      return get(/databases/$(database)/documents/departments/$(myDepartmentId())).data.name;
    }

    function sameDept(deptId) {
      return isSignedIn() && myDepartmentId() == deptId;
    }

    function onlyFieldsChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isCore() ||
        (isDeptHead() && resource.data.departmentId == myDepartmentId())
      );

      // Self-registration: new accounts start unassigned or applicant, never elevated,
      // and must use an @nift.ac.in email (defense-in-depth; also enforced client-side).
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role in ['unassigned', 'applicant'] &&
        request.resource.data.tedxId == null &&
        request.resource.data.email.lower().matches('.*@nift[.]ac[.]in$');

      // Users may update their own non-sensitive fields only.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        onlyFieldsChanged(['name']);

      // Admin/Core manage roles, departments, TEDx IDs, and status during approvals.
      allow update: if isCore();

      allow delete: if isAdmin();
    }

    // ---------- DEPARTMENTS ----------
    match /departments/{deptId} {
      allow read: if true; // public: needed by the /apply form
      // Department Heads may edit their own department's descriptive fields.
      allow update: if isDeptHead() && sameDept(deptId) &&
        onlyFieldsChanged(['description', 'purpose', 'responsibilities', 'goals', 'guidelines']);
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // ---------- APPLICATIONS ----------
    match /applications/{appId} {
      allow read: if isSignedIn() && (
        resource.data.applicantUserId == request.auth.uid ||
        isCore() ||
        (isDeptHead() && resource.data.departmentPreference == myDepartmentName())
      );

      allow create: if isSignedIn() &&
        request.resource.data.applicantUserId == request.auth.uid &&
        request.resource.data.status == 'SUBMITTED';

      // Department Head progresses their own department's applicants.
      allow update: if isDeptHead() &&
        resource.data.departmentPreference == myDepartmentName() &&
        onlyFieldsChanged(['status', 'updatedAt', 'reviewedBy', 'reviewedByName']) &&
        request.resource.data.status in [
          'UNDER_REVIEW', 'SHORTLISTED', 'INTERVIEW_SCHEDULED', 'INTERVIEW_COMPLETED', 'CORE_REVIEW'
        ];

      // Core/Admin make the final call.
      allow update: if isCore() &&
        onlyFieldsChanged(['status', 'updatedAt']);

      // Admin has unrestricted override on any field (correcting data, etc).
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ---------- INTERVIEWS ----------
    match /interviews/{interviewId} {
      allow read: if isCore() ||
        (isDeptHead() && resource.data.departmentId == myDepartmentId());

      allow create: if isCore() ||
        (isDeptHead() &&
          request.resource.data.departmentId == myDepartmentId() &&
          request.resource.data.interviewerUserId == request.auth.uid);

      allow update: if (isDeptHead() &&
          resource.data.departmentId == myDepartmentId() &&
          onlyFieldsChanged(['notes', 'ratings', 'recommendation', 'submittedAt'])) ||
        (isCore() && onlyFieldsChanged(['coreDecision'])) ||
        isAdmin();

      allow delete: if isAdmin();
    }

    // ---------- COUNTERS (TEDx ID generation) ----------
    match /counters/{counterId} {
      allow read, write: if isCore();
    }

    // ---------- SETTINGS ----------
    match /settings/{docId} {
      allow read: if true; // public: needed by the /apply form and public event-day display
      allow write: if (docId == 'eventDay' && isCore()) || (docId != 'eventDay' && isAdmin());
    }

    // ---------- TASKS ----------
    match /tasks/{taskId} {
      allow read: if isCore() ||
        (isSignedIn() && sameDept(resource.data.departmentId));

      allow create: if isCore() ||
        (isDeptHead() && request.resource.data.departmentId == myDepartmentId());

      // Managers (Core/Admin/matching Dept Head) can fully manage a task.
      allow update: if isCore() ||
        (isDeptHead() && resource.data.departmentId == myDepartmentId());

      // The assignee may update their own progress fields only.
      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.assignedTo &&
        onlyFieldsChanged(['status', 'attachments', 'updatedAt']);

      allow delete: if isCore() ||
        (isDeptHead() && resource.data.departmentId == myDepartmentId());
    }

    // ---------- TASK COMMENTS ----------
    match /taskComments/{commentId} {
      function taskDept() {
        return get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.departmentId;
      }
      function newTaskDept() {
        return get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.departmentId;
      }

      allow read: if isCore() || sameDept(taskDept());
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        (isCore() || sameDept(newTaskDept()));
      allow update, delete: if false;
    }

    // ---------- FILES (Cloudinary metadata) ----------
    match /files/{fileId} {
      allow read: if isCore() ||
        resource.data.uploadedBy == request.auth.uid ||
        (resource.data.departmentId != null && sameDept(resource.data.departmentId));

      allow create: if isSignedIn() && request.resource.data.uploadedBy == request.auth.uid;

      allow update: if (isCore() || (isDeptHead() && sameDept(resource.data.departmentId))) &&
        onlyFieldsChanged(['approvalStatus', 'approvedBy', 'approvedByName']);

      // Admin has unrestricted override on any field.
      allow update: if isAdmin();

      allow delete: if isCore() || resource.data.uploadedBy == request.auth.uid;
    }

    // ---------- ANNOUNCEMENTS ----------
    match /announcements/{announcementId} {
      allow read: if isSignedIn() && (
        resource.data.scope == 'org' ||
        isCore() ||
        sameDept(resource.data.departmentId)
      );

      allow create: if isCore() ||
        (isDeptHead() &&
          request.resource.data.scope == 'department' &&
          request.resource.data.departmentId == myDepartmentId());

      allow update, delete: if isCore() ||
        (isDeptHead() && resource.data.departmentId == myDepartmentId());
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        onlyFieldsChanged(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- MEETINGS ----------
    match /meetings/{meetingId} {
      allow read: if isCore() || isDeptHead() ||
        (isSignedIn() && request.auth.uid in resource.data.attendees);

      allow create: if isCore() || isDeptHead();
      allow update: if isCore() || isDeptHead();
      allow delete: if isCore();
    }

    // ---------- KNOWLEDGE BASE ----------
    match /knowledgeBase/{articleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- ISSUES / INCIDENTS ----------
    match /issues/{issueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow update: if isCore() || (isDeptHead() && sameDept(resource.data.departmentId));
      allow delete: if isAdmin();
    }

    // ---------- ACTIVITY LOGS (append-only audit trail) ----------
    match /activityLogs/{logId} {
      allow read: if isCore() ||
        (isDeptHead() && resource.data.departmentId == myDepartmentId());

      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
